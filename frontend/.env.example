# ============================================
# Frontend Environment Configuration
# TransfusionIQ - Blood Transfusion CDS System
# ============================================
#
# Instructions:
# 1. Copy this file to .env.local: copy .env.example .env.local (Windows) or cp .env.example .env.local (Linux/macOS)
# 2. Update the values below with your actual configuration
# 3. NEVER commit the .env.local file to git (it may contain secrets)
#
# Note: In Next.js, environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Do NOT include sensitive information (API keys, secrets) in NEXT_PUBLIC_ variables.
#
# ============================================

# --------------------------------------------
# API URL Configuration
# --------------------------------------------
# Backend API base URL
# This is the URL where your FastAPI backend is running
#
# Local development (backend on default port):
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Custom port:
# NEXT_PUBLIC_API_URL=http://localhost:8080
#
# Production (your actual API domain):
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
#
# With path prefix:
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api
