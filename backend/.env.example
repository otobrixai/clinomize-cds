# ============================================
# Backend Environment Configuration
# TransfusionIQ - Blood Transfusion CDS System
# ============================================
#
# Instructions:
# 1. Copy this file to .env: copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# 2. Update the values below with your actual configuration
# 3. NEVER commit the .env file to git (it contains secrets)
#
# ============================================

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# 
# Local development example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transfusion_cds
#
# With custom user:
# DATABASE_URL=postgresql://transfusion_user:your_password@localhost:5432/transfusion_cds
#
# Production with SSL:
# DATABASE_URL=postgresql://user:pass@db-host:5432/transfusion_cds?sslmode=require


# --------------------------------------------
# JWT Authentication
# --------------------------------------------
# Secret key for JWT token signing
# IMPORTANT: Generate a secure random string for production!
# 
# Generate secure key using Python:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Development (insecure - DO NOT USE IN PRODUCTION):
SECRET_KEY=dev-secret-key-change-in-production-use-random-string

# JWT algorithm (default: HS256)
ALGORITHM=HS256

# Access token expiration time in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# --------------------------------------------
# CORS Configuration
# --------------------------------------------
# Allowed origins for Cross-Origin Resource Sharing
# Format: JSON array of allowed frontend URLs
#
# Development (multiple local ports):
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
#
# Production (your actual domain):
# CORS_ORIGINS=["https://transfusioniq.yourdomain.com","https://app.transfusioniq.com"]
#
# Single origin:
# CORS_ORIGINS=["https://yourdomain.com"]


# --------------------------------------------
# AI Configuration (Optional)
# --------------------------------------------
# OpenAI API key for AI-generated explanations (admin-only feature)
# Leave empty if not using AI features
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Enable AI features (set to True to enable)
# AI features are admin-only and never shown in clinical UI
AI_ENABLED=False

# AI clinical access (hard-coded to False - cannot be enabled)
# This ensures AI is NEVER accessible to clinical users, only admins
AI_CLINICAL_ACCESS=False


# --------------------------------------------
# Optional: Environment Detection
# --------------------------------------------
# Uncomment to enable production mode validation
# ENVIRONMENT=production
#
# When ENVIRONMENT=production, the app will:
# - Require SECRET_KEY to be set (not use default)
# - Enforce stricter security settings
